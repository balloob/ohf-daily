{
  "name": "ohf-daily",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "collect": "node --import tsx scripts/collect.ts",
    "collect:demo": "node --import tsx scripts/collect.ts --demo",
    "update": "node --import tsx scripts/update.ts",
    "optimize:media": "node --import tsx scripts/optimize-media.ts",
    "query:prs": "node --import tsx scripts/query-prs.ts",
    "apply:editorial": "node --import tsx scripts/apply-editorial-plan.ts",
    "regenerate:editorial": "node --import tsx scripts/regenerate-editorial.ts",
    "backfill": "node --import tsx scripts/backfill.ts",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.2.9",
    "fast-xml-parser": "5.11.1",
    "fast-xml-validator": "1.4.2",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0"
  }
}
