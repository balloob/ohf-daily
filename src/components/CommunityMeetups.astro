---
import type { CommunityMeetup } from "../lib/types";

interface Props { meetups: CommunityMeetup[] }
const { meetups } = Astro.props;
---

{meetups.length === 1 && (
  <a class="single-meetup" href={meetups[0].url} target="_blank" rel="noreferrer">{meetups[0].title}<span aria-hidden="true"> ↗</span></a>
)}
{meetups.length > 1 && (
  <details class="community-meetups">
    <summary>
      <strong>{meetups.length} community meetups</strong>
      <span class="arrow" aria-hidden="true">›</span>
    </summary>
    <div class="meetup-list">
      <ul>
        {meetups.map((meetup) => (
          <li><a href={meetup.url} target="_blank" rel="noreferrer">{meetup.title}<span aria-hidden="true"> ↗</span></a></li>
        ))}
      </ul>
    </div>
  </details>
)}

<style>
  .community-meetups { min-width: 0; }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary strong { display: block; font: 700 0.68rem/1.2 var(--label); text-transform: uppercase; letter-spacing: 0.035em; }
  summary:focus-visible, a:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .arrow { font: 700 1.1rem/1 var(--sans); }
  details[open] .arrow { transform: rotate(90deg); }
  .meetup-list { max-height: min(28rem, 70vh); overflow-y: auto; padding: 0.8rem 0.4rem 0.3rem 0; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { padding: 0.5rem 0; border-top: 1px solid var(--rule); overflow-wrap: anywhere; }
  li a, .single-meetup { color: var(--ink); font: 600 0.76rem/1.35 var(--sans); overflow-wrap: anywhere; }
</style>
