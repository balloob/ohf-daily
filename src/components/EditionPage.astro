---
import type { Edition } from "../lib/types";
import type { EditorialArticle } from "./article-types";
import { formatEditionDate } from "../lib/editions";
import DependencyDialog from "./DependencyDialog.astro";
import Masthead from "./Masthead.astro";
import ReleaseRail from "./ReleaseRail.astro";
import ProjectPulse from "./ProjectPulse.astro";
import type { PulseItem } from "./article-types";
import { articleSlug } from "./article-path";
import StoryCard from "./StoryCard.astro";
import StoryImage from "./StoryImage.astro";

interface Props {
  edition: Edition & { articles?: EditorialArticle[]; pulse?: PulseItem[] };
  previousDate?: string;
  nextDate?: string;
}

const { edition, previousDate, nextDate } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const href = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
const articleHref = (article: EditorialArticle) => href(`/edition/${encodeURIComponent(edition.date)}/article/${articleSlug(article.id)}/`);
const editorialArticles = (Array.isArray(edition.articles) ? edition.articles : [])
  .filter((article) => article?.id && article?.title)
  .sort((a, b) => b.score - a.score);
const leadArticle = editorialArticles.find((article) => article.placement === "lead");
const deskArticles = editorialArticles.filter((article) => article.id !== leadArticle?.id);
const coveredPullRequests = new Set(editorialArticles.flatMap((article) => Array.isArray(article.pullRequests) ? article.pullRequests.map((pullRequest) => pullRequest.id) : []));
const visibleHighlights = edition.highlights.filter((story) => story.id !== edition.lead?.id && !coveredPullRequests.has(story.id));
const uniqueBriefs = edition.briefs.filter((story) => story.id !== edition.lead?.id && !coveredPullRequests.has(story.id) && !visibleHighlights.some((feature) => feature.id === story.id));
const windowLabel = `${new Intl.DateTimeFormat("en", { hour: "numeric", minute: "2-digit", timeZone: edition.timezone, timeZoneName: "short" }).format(new Date(edition.windowStart))}–${new Intl.DateTimeFormat("en", { hour: "numeric", minute: "2-digit", timeZone: edition.timezone, timeZoneName: "short" }).format(new Date(edition.windowEnd))}`;
---

<Masthead date={edition.date} />

<main id="main-content" class="shell">
  <div class="edition-summary">
    <p><strong>{edition.stats.mergedPullRequests}</strong> PRs merged</p>
    <p><strong>{edition.stats.repositories}</strong> repositories</p>
    <p><strong>{edition.stats.contributors}</strong> contributors</p>
    <p class="window">Reporting window: {windowLabel}</p>
  </div>

  <ProjectPulse items={edition.pulse} />

  {edition.isDemo && (
    <div class="demo-note" role="note">
      Demonstration edition · Sample stories show how the newspaper will look after a live collection run.
    </div>
  )}

  {leadArticle ? (
    <section class:list={["lead-section", { "weekly-lead": leadArticle.kind === "weekly_recap" }]} aria-labelledby="top-story-heading">
      <h1 id="top-story-heading" class="screen-reader-only">Top story for {formatEditionDate(edition.date)}</h1>
      <StoryCard article={leadArticle} variant="lead" articleHref={articleHref(leadArticle)} />
    </section>
  ) : edition.lead ? (
    <section class="lead-section" aria-labelledby="top-story-heading">
      <h1 id="top-story-heading" class="screen-reader-only">Top story for {formatEditionDate(edition.date)}</h1>
      <StoryCard story={edition.lead} variant="lead" showImage={true} />
    </section>
  ) : (
    <section class="quiet-edition">
      <div>
        <p class="eyebrow">A quiet news day</p>
        <h1>No front-page merges in this edition</h1>
        <p>The wire was checked for the full reporting window. Release dates and the archive remain available below.</p>
      </div>
      <StoryImage alt="The Open Home morning edition" priority={true} />
    </section>
  )}

  <div class="desk-grid">
    <div class="news-column">
      {deskArticles.length > 0 && (
        <section class="reported" aria-labelledby="reported-heading">
          <div class="rule-heading">
            <h2 id="reported-heading" class="section-title">Reported stories</h2>
            <span>{deskArticles.length} original {deskArticles.length === 1 ? "article" : "articles"}</span>
          </div>
          <div class="article-grid">
            {deskArticles.map((article) => (
              <StoryCard article={article} variant={article.placement === "brief" ? "brief" : "feature"} articleHref={articleHref(article)} />
            ))}
          </div>
        </section>
      )}

      {visibleHighlights.length > 0 && (
        <section class="highlights" aria-labelledby="highlights-heading">
          <div class="rule-heading">
            <h2 id="highlights-heading" class="section-title">{editorialArticles.length ? "Also merged" : "Merge desk"}</h2>
            <span>{visibleHighlights.length} direct {visibleHighlights.length === 1 ? "source" : "sources"}</span>
          </div>
          <div class="highlight-grid">
            {visibleHighlights.map((story, index) => (
              <StoryCard story={story} variant="feature" showImage={Boolean(story.image) && index < 2} />
            ))}
          </div>
        </section>
      )}

      {uniqueBriefs.length > 0 && (
        <section class="briefs" aria-labelledby="briefs-heading">
          <div class="rule-heading">
            <h2 id="briefs-heading" class="section-title">Across the projects</h2>
            <span>The daily wire</span>
          </div>
          <div class="brief-grid">
            {uniqueBriefs.map((story) => <StoryCard story={story} variant="brief" />)}
          </div>
        </section>
      )}

      <DependencyDialog items={edition.dependencies} />

      {edition.notes && edition.notes.length > 0 && (
        <aside class="editors-notes" aria-labelledby="notes-heading">
          <h2 id="notes-heading">Editor’s notes</h2>
          <ul>{edition.notes.map((note) => <li>{note}</li>)}</ul>
        </aside>
      )}
    </div>

    <ReleaseRail releases={edition.releases} today={edition.date} />
  </div>

  <nav class="edition-nav" aria-label="Edition navigation">
    <span>{nextDate ? <a href={href(`/edition/${nextDate}/`)}>← Newer edition</a> : "You’re reading the latest"}</span>
    <a class="all" href={href("/archive/")}>All editions</a>
    <span>{previousDate && <a href={href(`/edition/${previousDate}/`)}>Older edition →</a>}</span>
  </nav>
</main>

<footer class="site-footer shell">
  <p class="footer-name">OHF Daily</p>
  <p>Public work, reported daily. Every story links back to its source.</p>
  <a href="https://www.openhomefoundation.org/" target="_blank" rel="noreferrer">Open Home Foundation ↗</a>
</footer>

<style>
  main {
    padding-bottom: 2rem;
  }

  .edition-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem clamp(0.9rem, 3vw, 2.6rem);
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--rule);
    font: 500 0.7rem/1.35 var(--sans);
  }

  .edition-summary p {
    margin: 0;
  }

  .edition-summary strong {
    font-size: 0.86rem;
  }

  .edition-summary .window {
    margin-left: auto;
    color: var(--muted);
  }

  .demo-note {
    margin-top: 1rem;
    padding: 0.65rem 0.8rem;
    border-left: 4px solid var(--rust);
    background: #eee3ce;
    font: 600 0.72rem/1.4 var(--sans);
  }

  .lead-section,
  .quiet-edition {
    padding: clamp(1.5rem, 4vw, 3.4rem) 0;
    border-bottom: 3px double var(--rule-dark);
  }

  .weekly-lead {
    padding-inline: clamp(0rem, 2vw, 1.2rem);
  }

  .quiet-edition {
    display: grid;
    grid-template-columns: minmax(250px, 0.75fr) minmax(0, 1.25fr);
    gap: 2rem;
    align-items: center;
  }

  .quiet-edition h1 {
    margin: 0;
    font: 400 clamp(2.5rem, 5vw, 4.8rem)/0.98 var(--display);
  }

  .quiet-edition p:last-child {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.5;
  }

  .desk-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 290px;
    gap: clamp(1.4rem, 3vw, 2.6rem);
    padding-top: 2.2rem;
  }

  .release-rail {
    align-self: start;
    position: sticky;
    top: 1rem;
  }

  .rule-heading > span {
    color: var(--muted);
    font: 600 0.65rem/1.2 var(--label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .highlight-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .reported + .highlights,
  .reported + .briefs {
    margin-top: 2.3rem;
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
  }

  .article-grid :global(.story:nth-child(odd)) {
    padding-right: 1.5rem;
    border-right: 1px solid var(--rule);
  }

  .article-grid :global(.story:nth-child(even)) {
    padding-left: 1.5rem;
  }

  .article-grid :global(.story.recap) {
    grid-column: 1 / -1;
    padding-inline: 0;
    border-right: 0;
  }

  .highlight-grid :global(.story) {
    padding: 1.3rem 0;
    border-bottom: 1px solid var(--rule-dark);
  }

  .highlight-grid :global(.story:nth-child(odd)) {
    padding-right: 1.4rem;
    border-right: 1px solid var(--rule);
  }

  .highlight-grid :global(.story:nth-child(even)) {
    padding-left: 1.4rem;
  }

  .briefs {
    margin-top: 2.3rem;
  }

  .brief-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .brief-grid :global(.story) {
    padding-right: 1rem;
  }

  .brief-grid :global(.story:not(:nth-child(3n + 1))) {
    padding-left: 1rem;
    border-left: 1px solid var(--rule);
  }

  .editors-notes {
    margin-top: 2rem;
    padding: 1rem;
    border: 1px solid var(--rule);
    color: var(--muted);
    font: 400 0.75rem/1.5 var(--sans);
  }

  .editors-notes h2 {
    margin: 0 0 0.5rem;
    color: var(--ink);
    font: 700 0.68rem/1.3 var(--label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .editors-notes ul {
    margin: 0;
    padding-left: 1.2rem;
  }

  .edition-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    margin-top: 2.5rem;
    padding: 1rem 0;
    border-block: 3px double var(--rule-dark);
    font: 700 0.68rem/1.3 var(--label);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .edition-nav .all {
    text-align: center;
  }

  .edition-nav span:last-child {
    text-align: right;
  }

  .site-footer {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    gap: 1rem;
    align-items: baseline;
    padding: 1.5rem 0 3rem;
    color: var(--muted);
    font: 500 0.68rem/1.4 var(--sans);
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer a {
    justify-self: end;
  }

  .footer-name {
    color: var(--ink);
    font: 400 1.45rem/1 var(--display);
  }

  @media (max-width: 960px) {
    .desk-grid {
      grid-template-columns: minmax(0, 1fr) 250px;
    }

    .brief-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .brief-grid :global(.story:not(:nth-child(3n + 1))) {
      padding-left: 0;
      border-left: 0;
    }

    .brief-grid :global(.story:nth-child(even)) {
      padding-left: 1rem;
      border-left: 1px solid var(--rule);
    }
  }

  @media (max-width: 760px) {
    .edition-summary .window {
      flex-basis: 100%;
      margin: 0.3rem 0 0;
    }

    .quiet-edition,
    .desk-grid {
      grid-template-columns: 1fr;
    }

    .quiet-edition :global(.story-image) {
      grid-row: 1;
    }

    .release-rail {
      position: static;
      grid-row: 1;
    }

    .article-grid {
      grid-template-columns: 1fr;
    }

    .article-grid :global(.story:nth-child(n)) {
      padding-inline: 0;
      border-right: 0;
    }

    .site-footer {
      grid-template-columns: 1fr;
    }

    .site-footer a {
      justify-self: start;
    }
  }

  @media (max-width: 580px) {
    .highlight-grid,
    .brief-grid {
      grid-template-columns: 1fr;
    }

    .highlight-grid :global(.story:nth-child(odd)),
    .highlight-grid :global(.story:nth-child(even)),
    .brief-grid :global(.story:nth-child(even)) {
      padding-inline: 0;
      border-left: 0;
      border-right: 0;
    }

    .rule-heading > span {
      display: none;
    }

    .edition-nav {
      grid-template-columns: 1fr 1fr;
    }

    .edition-nav .all {
      display: none;
    }
  }
</style>
