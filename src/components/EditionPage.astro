---
import type { Edition } from "../lib/types";
import type { EditorialArticle } from "./article-types";
import { formatEditionDate } from "../lib/editions";
import Masthead from "./Masthead.astro";
import PreviousEditionLink from "./PreviousEditionLink.astro";
import ReleaseRail from "./ReleaseRail.astro";
import RoadmapRail from "./RoadmapRail.astro";
import ProjectPulse from "./ProjectPulse.astro";
import type { PulseItem } from "./article-types";
import { articleSlug } from "./article-path";
import StoryCard from "./StoryCard.astro";
import StoryImage from "./StoryImage.astro";

interface Props {
  edition: Edition & { articles?: EditorialArticle[]; pulse?: PulseItem[] };
  previousDate?: string;
  nextDate?: string;
}

const { edition, previousDate, nextDate } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const href = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
const articleHref = (article: EditorialArticle) => href(`/edition/${encodeURIComponent(edition.date)}/article/${articleSlug(article.id)}/`);
const editorialArticles = (Array.isArray(edition.articles) ? edition.articles : [])
  .filter((article) => article?.id && article?.title && article.frontPage !== false)
  .sort((a, b) => b.score - a.score);
const leadArticle = editorialArticles.find((article) => article.placement === "lead");
const deskArticles = editorialArticles.filter((article) => article.id !== leadArticle?.id);
const columnFeatures = deskArticles.filter((article) => article.placement !== "brief");
const columnBriefs = deskArticles.filter((article) => article.placement === "brief");
const coveredPullRequests = new Set(editorialArticles.flatMap((article) => Array.isArray(article.pullRequests) ? article.pullRequests.map((pullRequest) => pullRequest.id) : []));
const releaseSourcePullRequests = new Set((edition.landedReleases ?? []).flatMap((release) => release.sourcePullRequestIds ?? []));
const hasEditorial = Array.isArray(edition.articles) || Boolean(edition.roadmapUpdates?.length);
const visibleHighlights = hasEditorial ? [] : edition.highlights.filter(
  (story) => story.id !== edition.lead?.id && !coveredPullRequests.has(story.id) && !releaseSourcePullRequests.has(story.id),
);
const uniqueBriefs = hasEditorial ? [] : edition.briefs.filter(
  (story) => story.id !== edition.lead?.id
    && !coveredPullRequests.has(story.id)
    && !releaseSourcePullRequests.has(story.id)
    && !visibleHighlights.some((feature) => feature.id === story.id),
);
const hasPulse = Array.isArray(edition.pulse) && edition.pulse.some((item) => item?.product);
---

<Masthead date={edition.date} {previousDate} />

<main id="main-content" class="shell">
  <section class:list={["edition-dashboard", { "has-pulse": hasPulse }]} aria-label="Edition activity">
    <div class="edition-summary">
      <div class="summary-label">
        <p>In this edition</p>
      </div>
      <dl>
        <div><dd>{edition.stats.mergedPullRequests}</dd><dt>PRs</dt></div>
        <div><dd>{edition.stats.repositories}</dd><dt>repositories</dt></div>
        <div><dd>{edition.stats.contributors}</dd><dt>contributors</dt></div>
      </dl>
    </div>
    <ProjectPulse items={edition.pulse} />
  </section>

  {edition.isDemo && (
    <div class="demo-note" role="note">
      Demonstration edition · Sample stories show how the newspaper will look after a live collection run.
    </div>
  )}

  {leadArticle ? (
    <section class:list={["lead-section", { "weekly-lead": leadArticle.kind === "weekly_recap" }]} aria-labelledby="top-story-heading">
      <h1 id="top-story-heading" class="screen-reader-only">Top story for {formatEditionDate(edition.date)}</h1>
      <StoryCard article={leadArticle} variant="lead" articleHref={articleHref(leadArticle)} />
    </section>
  ) : !hasEditorial && edition.lead ? (
    <section class="lead-section" aria-labelledby="top-story-heading">
      <h1 id="top-story-heading" class="screen-reader-only">Top story for {formatEditionDate(edition.date)}</h1>
      <StoryCard story={edition.lead} variant="lead" showImage={true} />
    </section>
  ) : (
    <section class="quiet-edition">
      <div>
        <p class="eyebrow">A quiet news day</p>
        <h1>No front-page stories in this edition</h1>
        <p>The wire was checked for the full reporting window. Release dates and the archive remain available below.</p>
      </div>
      <StoryImage alt="The Open Home morning edition" priority={true} />
    </section>
  )}

  <div class="desk-grid" data-newsroom>
    <div class="news-column">
      {deskArticles.length > 0 && (
        <section class="reported" aria-labelledby="reported-heading">
          <div class="rule-heading">
            <h2 id="reported-heading" class="section-title">Reported stories</h2>
            <span>{deskArticles.length} original {deskArticles.length === 1 ? "article" : "articles"}</span>
          </div>
        </section>
      )}

      {visibleHighlights.length > 0 && (
        <section class="highlights" aria-labelledby="highlights-heading">
          <div class="rule-heading">
            <h2 id="highlights-heading" class="section-title">{editorialArticles.length ? "More stories" : "Development desk"}</h2>
            <span>{visibleHighlights.length} direct {visibleHighlights.length === 1 ? "source" : "sources"}</span>
          </div>
          <div class="highlight-grid">
            {visibleHighlights.map((story, index) => (
              <StoryCard story={story} variant="feature" showImage={Boolean(story.image) && index < 2} />
            ))}
          </div>
        </section>
      )}

      {uniqueBriefs.length > 0 && (
        <section class="briefs" aria-labelledby="briefs-heading">
          <div class="rule-heading">
            <h2 id="briefs-heading" class="section-title">Across the projects</h2>
            <span>The daily wire</span>
          </div>
          <div class="brief-grid">
            {uniqueBriefs.map((story) => <StoryCard story={story} variant="brief" />)}
          </div>
        </section>
      )}

    </div>

    <section class:list={["article-spread", { "briefs-only": columnFeatures.length === 0, "features-only": columnBriefs.length === 0 }]} aria-label="Reported stories and calendar">
      {columnFeatures.length > 0 && (
        <div class="feature-column">
          {columnFeatures.map((article) => (
            <StoryCard article={article} variant="feature" articleHref={articleHref(article)} />
          ))}
        </div>
      )}
      <div class="story-side-columns">
        <div class="brief-columns" data-brief-primary>
          {columnBriefs.map((article) => (
            <StoryCard article={article} variant="brief" articleHref={articleHref(article)} />
          ))}
        </div>
        <div class="edition-sidebar">
          <div class="calendar-column" data-calendar-column>
            <RoadmapRail updates={edition.roadmapUpdates} articles={edition.articles} date={edition.date} />
            <ReleaseRail
              releases={edition.releases}
              landedReleases={edition.landedReleases}
              publishedPosts={edition.publishedPosts}
              hacsNewIntegrations={edition.stats.hacsNewIntegrations}
              communityMeetups={edition.communityMeetups}
              today={edition.date}
            />
          </div>
          <div class="brief-columns" data-brief-secondary></div>
        </div>
      </div>
    </section>
  </div>

  <nav class="edition-nav" aria-label="Edition navigation">
    <span>{previousDate && <PreviousEditionLink date={edition.date} {previousDate} />}</span>
    <a class="all" href={href("/archive/")}>All editions</a>
    <span>{nextDate ? <a href={href(`/edition/${nextDate}/`)}>Newer edition →</a> : "You’re reading the latest"}</span>
  </nav>
</main>

<footer class="site-footer shell">
  <p class="footer-name">OHF Daily</p>
  <a href="https://www.openhomefoundation.org/" target="_blank" rel="noreferrer">Open Home Foundation ↗</a>
</footer>

<script>
  document.querySelectorAll<HTMLElement>("[data-newsroom]").forEach((newsroom) => {
    const primary = newsroom.querySelector<HTMLElement>("[data-brief-primary]");
    const secondary = newsroom.querySelector<HTMLElement>("[data-brief-secondary]");
    const calendar = newsroom.querySelector<HTMLElement>("[data-calendar-column]");
    const columns = newsroom.querySelector<HTMLElement>(".story-side-columns");
    if (!primary || !secondary || !calendar || !columns) return;
    const briefs = Array.from(primary.children) as HTMLElement[];
    if (!briefs.length) return;
    let frame = 0;
    let previousWidth = -1;
    const balance = () => {
      const focused = document.activeElement as HTMLElement | null;
      primary.append(...briefs);
      if (matchMedia("(min-width: 761px)").matches) {
        const heights = briefs.map((brief) => brief.getBoundingClientRect().height);
        const total = heights.reduce((sum, height) => sum + height, 0);
        const gap = parseFloat(getComputedStyle(secondary.parentElement!).rowGap) || 0;
        const rail = calendar.getBoundingClientRect().height + gap;
        let left = 0;
        let split = briefs.length;
        let best = Math.abs(total - rail);
        // Keep ranking order within each column, starting the second below the calendar.
        for (let index = 1; index < briefs.length; index++) {
          left += heights[index - 1];
          const difference = Math.abs(left - (rail + total - left));
          if (difference < best) { best = difference; split = index; }
        }
        secondary.append(...briefs.slice(split));
      }
      if (focused && briefs.some((brief) => brief.contains(focused))) focused.focus({ preventScroll: true });
    };
    const schedule = () => { cancelAnimationFrame(frame); frame = requestAnimationFrame(balance); };
    new ResizeObserver(([entry]) => {
      if (entry.contentRect.width !== previousWidth) {
        previousWidth = entry.contentRect.width;
        schedule();
      }
    }).observe(columns);
    new ResizeObserver(schedule).observe(calendar);
    document.fonts.ready.then(schedule);
    schedule();
  });
</script>

<style>
  main {
    padding-bottom: 2rem;
  }

  .edition-dashboard {
    border-bottom: 3px double var(--rule-dark);
  }

  .edition-dashboard.has-pulse {
    display: grid;
    grid-template-columns: minmax(380px, 0.9fr) minmax(0, 2.1fr);
    gap: 1rem;
  }

  .edition-dashboard :global(.pulse) {
    border-bottom: 0;
  }

  .edition-dashboard:not(.has-pulse) .edition-summary {
    border-right: 0;
  }

  .edition-summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.7rem 1rem 0.7rem 0;
    border-right: 1px solid var(--rule-dark);
  }

  .summary-label {
    display: flex;
    align-items: center;
    padding-right: 0.75rem;
    border-right: 1px solid var(--rule);
  }

  .summary-label p {
    margin: 0;
    color: var(--accent);
    font: 700 0.55rem/1 var(--label);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .edition-summary dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    align-items: center;
    margin: 0;
  }

  .edition-summary dt {
    color: var(--muted);
    font: 500 0.52rem/1.2 var(--sans);
    white-space: nowrap;
  }

  .edition-summary dl > div {
    display: flex;
    gap: 0.28rem;
    align-items: baseline;
    min-width: 0;
  }

  .edition-summary dd {
    margin: 0;
    font: 700 0.8rem/1.2 var(--label);
  }

  .demo-note {
    margin-top: 1rem;
    padding: 0.65rem 0.8rem;
    border-left: 4px solid var(--rust);
    background: #eee3ce;
    font: 600 0.72rem/1.4 var(--sans);
  }

  .lead-section,
  .quiet-edition {
    padding: clamp(1.5rem, 4vw, 3.4rem) 0;
    border-bottom: 3px double var(--rule-dark);
  }

  .weekly-lead {
    padding-inline: clamp(0rem, 2vw, 1.2rem);
  }

  .quiet-edition {
    display: grid;
    grid-template-columns: minmax(250px, 0.75fr) minmax(0, 1.25fr);
    gap: 2rem;
    align-items: center;
  }

  .quiet-edition h1 {
    margin: 0;
    font: 400 clamp(2.5rem, 5vw, 4.8rem)/0.98 var(--display);
  }

  .quiet-edition p:last-child {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.5;
  }

  .desk-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.4rem, 3vw, 2.6rem);
    padding-top: 2.2rem;
  }

  .edition-sidebar {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
    align-self: start;
  }

  .calendar-column {
    display: grid;
    gap: 1.5rem;
  }

  .story-side-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.8rem, 4vw, 2.7rem);
    align-items: start;
    min-width: 0;
  }

  .story-side-columns > .brief-columns {
    padding-right: 1.35rem;
    border-right: 1px solid var(--rule);
  }

  .brief-columns:empty { display: none; }

  .rule-heading > span {
    color: var(--muted);
    font: 600 0.65rem/1.2 var(--label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .highlight-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .reported + .highlights,
  .reported + .briefs {
    margin-top: 2.3rem;
  }

  .article-spread {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.8rem, 4vw, 2.7rem);
    align-items: start;
    border-bottom: 1px solid var(--rule-dark);
  }

  .feature-column,
  .brief-columns {
    min-width: 0;
  }

  .feature-column {
    padding-right: clamp(0.9rem, 2vw, 1.35rem);
    border-right: 1px solid var(--rule);
  }

  .brief-columns {
    display: grid;
    align-content: start;
  }

  .brief-columns :global(.story) {
    break-inside: avoid;
    border-top: 0;
  }

  .article-spread .brief-columns :global(.editorial-article.brief h2) {
    max-width: none;
    font-size: 1.45rem;
    line-height: 1.12;
  }

  .brief-columns :global(.dek) {
    margin-block: 0.65rem;
    font-size: 1rem;
    line-height: 1.4;
  }

  .feature-column :global(.story:last-child),
  .brief-columns :global(.story:last-child) {
    border-bottom: 0;
  }

  .article-spread.briefs-only {
    grid-template-columns: minmax(0, 1fr);
  }

  .article-spread.features-only:not(.briefs-only) {
    grid-template-columns: minmax(0, 1fr) 290px;
  }

  .features-only .story-side-columns {
    grid-template-columns: minmax(0, 1fr);
  }

  .reported > .rule-heading {
    border-top: 0;
  }

  .highlight-grid :global(.story) {
    padding: 1.3rem 0;
    border-bottom: 1px solid var(--rule-dark);
  }

  .highlight-grid :global(.story:nth-child(odd)) {
    padding-right: 1.4rem;
    border-right: 1px solid var(--rule);
  }

  .highlight-grid :global(.story:nth-child(even)) {
    padding-left: 1.4rem;
  }

  .briefs {
    margin-top: 2.3rem;
  }

  .brief-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .brief-grid :global(.story) {
    padding-right: 1rem;
  }

  .brief-grid :global(.story:not(:nth-child(3n + 1))) {
    padding-left: 1rem;
    border-left: 1px solid var(--rule);
  }

  .edition-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    margin-top: 2.5rem;
    padding: 1rem 0;
    border-block: 3px double var(--rule-dark);
    font: 700 0.68rem/1.3 var(--label);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .edition-nav .all {
    text-align: center;
  }

  .edition-nav span:last-child {
    text-align: right;
  }

  .site-footer {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding: 1.5rem 0 3rem;
    color: var(--muted);
    font: 500 0.68rem/1.4 var(--sans);
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer a {
    justify-self: end;
  }

  .footer-name {
    color: var(--ink);
    font: 400 1.45rem/1 var(--display);
  }

  @media (max-width: 1100px) {
    .article-spread,
    .article-spread.features-only:not(.briefs-only) {
      grid-template-columns: minmax(0, 1fr);
    }

    .feature-column {
      padding-right: 0;
      border-right: 0;
    }
  }

  @media (max-width: 960px) {

    .brief-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .brief-grid :global(.story:not(:nth-child(3n + 1))) {
      padding-left: 0;
      border-left: 0;
    }

    .brief-grid :global(.story:nth-child(even)) {
      padding-left: 1rem;
      border-left: 1px solid var(--rule);
    }

  }

  @media (max-width: 1280px) {
    .edition-dashboard.has-pulse {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .edition-summary {
      padding-right: 0;
      border-right: 0;
      border-bottom: 1px solid var(--rule-dark);
    }
  }

  @media (max-width: 760px) {
    .quiet-edition,
    .desk-grid,
    .article-spread,
    .article-spread.features-only:not(.briefs-only) {
      grid-template-columns: 1fr;
    }

    .quiet-edition :global(.story-image) {
      grid-row: 1;
    }

    .feature-column {
      padding-right: 0;
      border-right: 0;
    }

    .story-side-columns { grid-template-columns: minmax(0, 1fr); }
    .story-side-columns > .brief-columns { padding-right: 0; border-right: 0; }

    .site-footer {
      grid-template-columns: 1fr;
    }

    .site-footer a {
      justify-self: start;
    }
  }

  @media (max-width: 580px) {
    .highlight-grid,
    .brief-grid {
      grid-template-columns: 1fr;
    }

    .highlight-grid :global(.story:nth-child(odd)),
    .highlight-grid :global(.story:nth-child(even)),
    .brief-grid :global(.story:nth-child(even)) {
      padding-inline: 0;
      border-left: 0;
      border-right: 0;
    }

    .rule-heading > span {
      display: none;
    }

    .edition-nav {
      grid-template-columns: 1fr 1fr;
    }

    .edition-nav .all {
      display: none;
    }
  }
</style>
