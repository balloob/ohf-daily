---
import type { LandedRelease, ReleaseEvent } from "../lib/types";
import { releasesForRadar } from "../lib/releases";

interface Props {
  releases: ReleaseEvent[];
  landedReleases?: LandedRelease[];
  hacsNewIntegrations?: number;
  today?: string;
}

const { releases, landedReleases = [], hacsNewIntegrations, today = new Date().toISOString().slice(0, 10) } = Astro.props;
const day = 86_400_000;
const daysUntil = (date: string) => Math.ceil((Date.parse(`${date}T12:00:00Z`) - Date.parse(`${today}T12:00:00Z`)) / day);
const formatShort = (date: string) => new Intl.DateTimeFormat("en", { day: "numeric", month: "short", timeZone: "UTC" }).format(new Date(`${date}T12:00:00Z`));
const dateVersion = (date: string) => {
  const [year, month] = date.split("-").map(Number);
  return `${year}.${month}`;
};
const versionFor = (event: ReleaseEvent) => event.version ?? dateVersion(
  event.kind === "Beta"
    ? releases.find((candidate) => candidate.product === event.product && candidate.kind === "Release" && candidate.date >= event.date)?.date ?? event.date
    : event.date,
);
const detailFor = (event: ReleaseEvent) => event.kind === "Event"
  ? event.endDate && event.endDate !== event.date ? `Event · through ${formatShort(event.endDate)}` : "Event"
  : `${versionFor(event)} ${event.kind}`;
const shipped = releasesForRadar(landedReleases)
  .filter((release) => release?.url && Number.isFinite(Date.parse(release.publishedAt)))
  .sort((left, right) => right.publishedAt.localeCompare(left.publishedAt));
const visibleShipped = shipped.slice(0, 6);
const shippedOverflow = shipped.length - visibleShipped.length;
const hacsCount = typeof hacsNewIntegrations === "number" && Number.isSafeInteger(hacsNewIntegrations) && hacsNewIntegrations > 0
  ? hacsNewIntegrations
  : undefined;
const hasShippedItems = visibleShipped.length > 0 || hacsCount !== undefined;
const upcoming = releases
  .map((release) => ({
    ...release,
    remaining: release.kind === "Event" && release.date < today && (release.endDate ?? release.date) >= today ? 0 : daysUntil(release.date),
  }))
  .filter((release) => Number.isFinite(release.remaining) && release.remaining >= 0 && release.remaining <= (release.kind === "Event" ? 90 : 45))
  .sort((left, right) => left.date.localeCompare(right.date));
---

<aside class="release-rail" aria-label="Release radar">
  {hasShippedItems && (
    <section class="shipped" aria-labelledby="shipped-heading">
      <div class="heading">
        <p class="eyebrow">Release radar</p>
        <h2 id="shipped-heading">Just shipped</h2>
      </div>
      <ul class="shipped-list">
        {visibleShipped.map((release) => (
          <li style={`--event-accent: var(--${release.accent}, var(--accent))`}>
            <a href={release.url} target="_blank" rel="noreferrer">
              <span class="release-name"><strong>{release.product}</strong><small>{release.tag}</small></span>
              <span class="release-meta"><small>{release.channel}</small></span>
              <span class="more-information" aria-hidden="true">›</span>
            </a>
          </li>
        ))}
        {hacsCount !== undefined && (
          <li class="hacs-summary" style="--event-accent: var(--blue, var(--accent))">
            <span class="release-name"><strong>HACS</strong><small>{hacsCount} new {hacsCount === 1 ? "integration" : "integrations"}</small></span>
            <span class="release-meta"><small>index</small></span>
          </li>
        )}
      </ul>
      {shippedOverflow > 0 && <p class="overflow">+{shippedOverflow} more landed {shippedOverflow === 1 ? "release" : "releases"}</p>}
    </section>
  )}

  <section class:list={["horizon", { "with-shipped": hasShippedItems }]} aria-labelledby="horizon-heading">
    <div class="horizon-heading">
      <p class="eyebrow">On the horizon</p>
      <h2 id="horizon-heading">Upcoming</h2>
    </div>
    {upcoming.length ? (
      <ol class="upcoming-list">
        {upcoming.map((release) => (
          <li style={`--event-accent: var(--${release.accent}, var(--accent))`}>
            <time datetime={release.date}>
              <span>{formatShort(release.date)}</span>
              <small>{release.remaining === 0 ? "Today" : release.remaining === 1 ? "Tomorrow" : `${release.remaining}d`}</small>
            </time>
            {release.url ? (
              <a class="upcoming-name" href={release.url} target="_blank" rel="noreferrer">
                <strong>{release.product}</strong><small>{detailFor(release)}</small><span class="more-information" aria-hidden="true">›</span>
              </a>
            ) : (
              <span class="upcoming-name"><strong>{release.product}</strong><small>{detailFor(release)}</small></span>
            )}
          </li>
        ))}
      </ol>
    ) : <p class="empty">Nothing scheduled in the next 45 days.</p>}
  </section>
</aside>

<style>
  .release-rail {
    padding: 0.9rem;
    border: 1px solid var(--rule-dark);
    background: rgb(255 255 255 / 20%);
  }

  .heading {
    padding-bottom: 0.8rem;
    border-bottom: 3px double var(--rule-dark);
  }

  .heading h2 {
    margin: 0;
    font: 400 1.55rem/1 var(--display);
  }

  ul,
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shipped-list li {
    border-bottom: 1px solid var(--rule);
  }

  .shipped-list a,
  .hacs-summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem;
    align-items: baseline;
    padding: 0.65rem 0.25rem 0.65rem 0.55rem;
    border-left: 3px solid var(--event-accent);
    text-decoration: none;
  }

  .shipped-list a {
    grid-template-columns: minmax(0, 1fr) auto 0.7rem;
  }

  .release-name,
  .release-meta,
  .upcoming-name {
    display: flex;
    flex-direction: column;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .release-name strong,
  .upcoming-name strong {
    overflow: hidden;
    font: 700 0.68rem/1.2 var(--label);
    letter-spacing: 0.035em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .upcoming-name strong {
    overflow: visible;
    text-overflow: clip;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .release-name small,
  .release-meta,
  .upcoming-name small {
    color: var(--muted);
    font: 500 0.61rem/1.2 var(--sans);
  }

  a.upcoming-name {
    position: relative;
    padding-right: 1rem;
  }

  a.upcoming-name .more-information {
    position: absolute;
    top: 50%;
    right: 0.1rem;
    transform: translateY(-50%);
  }

  .more-information {
    color: var(--muted);
    font: 700 1.05rem/1 var(--sans);
    transition: color 120ms ease, transform 120ms ease;
  }

  a:hover .more-information,
  a:focus-visible .more-information {
    color: var(--ink);
  }

  a.upcoming-name:hover .more-information,
  a.upcoming-name:focus-visible .more-information {
    transform: translate(0.12rem, -50%);
  }

  .shipped-list a:hover .more-information,
  .shipped-list a:focus-visible .more-information {
    transform: translateX(0.12rem);
  }

  .release-meta {
    align-items: end;
    text-align: right;
  }

  .release-meta small {
    text-transform: capitalize;
  }

  .overflow,
  .empty {
    margin: 0;
    padding-top: 0.7rem;
    color: var(--muted);
    font: 600 0.62rem/1.35 var(--sans);
  }

  .horizon.with-shipped {
    margin-top: 1rem;
    padding-top: 0.8rem;
    border-top: 3px double var(--rule-dark);
  }

  .horizon-heading {
    display: flex;
    gap: 0.45rem;
    align-items: baseline;
  }

  .horizon-heading .eyebrow {
    margin: 0;
  }

  .horizon-heading h2 {
    margin: 0;
    font: 400 1.15rem/1 var(--display);
  }

  .upcoming-list {
    margin-top: 0.45rem;
  }

  .upcoming-list li {
    display: grid;
    grid-template-columns: 4.35rem minmax(0, 1fr);
    gap: 0.65rem;
    padding: 0.55rem 0;
    border-top: 1px solid var(--rule);
  }

  .upcoming-list time {
    display: flex;
    justify-content: space-between;
    gap: 0.25rem;
    padding-left: 0.4rem;
    border-left: 3px solid var(--event-accent);
    font: 700 0.65rem/1.2 var(--label);
    text-transform: uppercase;
  }

  .upcoming-list time small {
    color: var(--muted);
    font: 500 0.57rem/1.2 var(--sans);
    text-transform: none;
  }
</style>
