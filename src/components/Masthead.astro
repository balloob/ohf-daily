---
import { formatEditionDate } from "../lib/editions";

interface Props {
  date?: string;
  previousDate?: string;
  section?: string;
}

const { date, previousDate, section = "The Open Home Foundation world, one day at a time" } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const href = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
const day = 86_400_000;
const previousIsYesterday = Boolean(date && previousDate)
  && (Date.parse(`${date}T12:00:00Z`) - Date.parse(`${previousDate}T12:00:00Z`)) / day === 1;
const previousLabel = previousIsYesterday ? "Yesterday" : "Previous edition";
---

<header class="masthead shell">
  <div class="utility">
    <p>{date ? formatEditionDate(date) : "Daily open-source intelligence"}</p>
    <p class="edition-mark">Independent · Automated · Open</p>
    <div class="utility-links">
      {previousDate && (
        <a
          class="previous-edition"
          href={href(`/edition/${previousDate}/`)}
          aria-label={`${previousLabel}: ${formatEditionDate(previousDate)}`}
        >← {previousLabel}</a>
      )}
      <a href={href("/archive/")}>Archive</a>
      <a class="rss-link" href={href("/rss.xml")}>RSS</a>
    </div>
  </div>
  <div class="nameplate">
    <a href={href("/")} aria-label="OHF Daily home">
      <img class="mark" src={href("/ohf-house.svg")} alt="" aria-hidden="true" />
      <span>OHF Daily</span>
    </a>
  </div>
  <div class="strapline">
    <span>{section}</span>
    <span class="read-time">A five-minute briefing</span>
  </div>
</header>

<style>
  .masthead {
    padding-top: 1rem;
  }

  .utility,
  .strapline {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    min-height: 2.2rem;
    border-block: 1px solid var(--rule-dark);
    font: 600 0.68rem/1.2 var(--label);
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .utility p {
    margin: 0;
  }

  .utility-links {
    display: flex;
    gap: 0.85rem;
    justify-self: end;
    white-space: nowrap;
  }

  .previous-edition {
    color: var(--ink);
    text-decoration-thickness: 1px;
  }

  .edition-mark {
    color: var(--muted);
  }

  .nameplate {
    padding: clamp(1rem, 3vw, 2rem) 0 clamp(0.8rem, 2vw, 1.5rem);
    text-align: center;
  }

  .nameplate a {
    display: inline-flex;
    align-items: center;
    color: var(--ink);
    font: 400 clamp(3.3rem, 8vw, 7.8rem)/0.82 var(--display);
    letter-spacing: -0.07em;
    text-decoration: none;
  }

  .mark {
    width: clamp(1.7rem, 3.8vw, 3.7rem);
    height: clamp(2.5rem, 5.5vw, 5.35rem);
    margin: 0.02em 0.2em 0 -0.02em;
    object-fit: contain;
  }

  .strapline {
    grid-template-columns: 1fr auto;
    border-bottom-width: 3px;
    padding-block: 0.15rem;
  }

  .read-time {
    color: var(--muted);
  }

  @media (max-width: 650px) {
    .utility {
      grid-template-columns: 1fr auto;
    }

    .edition-mark,
    .read-time {
      display: none;
    }

    .nameplate a {
      letter-spacing: -0.055em;
    }
  }

  @media (max-width: 500px) {
    .utility,
    .utility-links {
      gap: 0.6rem;
    }

    .rss-link {
      display: none;
    }
  }
</style>
