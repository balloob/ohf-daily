---
import type { DependencyItem } from "../lib/types";

interface Props {
  items: DependencyItem[];
}

const { items } = Astro.props;
const dialogId = `dependencies-${Math.random().toString(36).slice(2)}`;
---

{items.length > 0 && (
  <section class="dependency-strip" aria-labelledby={`${dialogId}-heading`}>
    <div>
      <p class="eyebrow">Maintenance wire</p>
      <h2 id={`${dialogId}-heading`}>{items.length} dependency {items.length === 1 ? "update" : "updates"}, neatly bundled</h2>
      <p>Routine version bumps are kept off the front page, but every merge is still on the record.</p>
    </div>
    <button type="button" data-open-dialog={dialogId}>View all updates <span aria-hidden="true">↗</span></button>
    <dialog id={dialogId} aria-labelledby={`${dialogId}-title`}>
      <div class="dialog-head">
        <form method="dialog" class="mobile-back"><button aria-label="Back to the edition"><span aria-hidden="true">←</span> Back to edition</button></form>
        <div>
          <p class="eyebrow">Maintenance wire</p>
          <h2 id={`${dialogId}-title`}>Dependency updates</h2>
        </div>
        <form method="dialog"><button class="close" aria-label="Close dependency updates">×</button></form>
      </div>
      <ul>
        {items.map((item) => (
          <li>
            <a href={item.url} target="_blank" rel="noreferrer">{item.title}</a>
            <span>{item.repository} · {item.author}</span>
          </li>
        ))}
      </ul>
      <form method="dialog" class="dialog-foot"><button>Close</button></form>
    </dialog>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>("[data-open-dialog]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const id = trigger.dataset.openDialog;
      const dialog = id ? document.getElementById(id) : null;
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
    });
  });
</script>

<style>
  .dependency-strip {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: center;
    margin-block: 2rem;
    padding: 1.4rem 1.6rem;
    border-block: 1px solid var(--rule-dark);
    background: var(--paper-deep);
  }

  h2 {
    margin: 0;
    font: 400 clamp(1.4rem, 2.5vw, 2rem)/1.05 var(--display);
  }

  .dependency-strip p:not(.eyebrow) {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font: 400 0.78rem/1.4 var(--sans);
  }

  button {
    padding: 0.72rem 0.9rem;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    font: 700 0.68rem/1 var(--label);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  button:hover {
    background: var(--ink);
    color: var(--paper);
  }

  dialog {
    width: min(calc(100% - 2rem), 720px);
    max-width: 720px;
    max-height: min(80vh, 760px);
    padding: 0;
    border: 1px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 20px 70px rgb(0 0 0 / 35%);
    overflow-x: hidden;
  }

  dialog::backdrop {
    background: rgb(16 16 13 / 64%);
    backdrop-filter: blur(2px);
  }

  .dialog-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.4rem;
    border-bottom: 3px double var(--ink);
  }

  .mobile-back {
    display: none;
  }

  .close {
    min-width: 2.5rem;
    padding: 0.4rem;
    font-size: 1.4rem;
  }

  ul {
    margin: 0;
    padding: 0 1.4rem;
    list-style: none;
    overflow: auto;
  }

  li {
    min-width: 0;
    display: grid;
    gap: 0.22rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
  }

  li a {
    overflow-wrap: anywhere;
    font: 400 1.05rem/1.3 Georgia, serif;
  }

  li span {
    color: var(--muted);
    font: 500 0.67rem/1.3 var(--sans);
  }

  .dialog-foot {
    display: flex;
    justify-content: flex-end;
    padding: 1rem 1.4rem;
  }

  @media (max-width: 620px) {
    .dependency-strip {
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-inline: -12px;
      padding-inline: 12px;
    }

    .dependency-strip > button {
      justify-self: start;
    }

    dialog[open] {
      position: fixed;
      inset: 0;
      display: flex;
      flex-direction: column;
      width: 100%;
      max-width: 100%;
      height: 100dvh;
      max-height: 100dvh;
      margin: 0;
      border: 0;
      overflow: hidden;
    }

    .dialog-head {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0.8rem;
      flex: 0 0 auto;
      padding: max(0.8rem, env(safe-area-inset-top)) 12px 0.9rem;
      background: var(--paper);
    }

    .mobile-back {
      display: block;
      grid-column: 1 / -1;
    }

    .mobile-back button {
      width: 100%;
      padding: 0.85rem 1rem;
      border: 0;
      background: var(--ink);
      color: var(--paper);
      text-align: left;
    }

    .dialog-head > form:not(.mobile-back) {
      display: none;
    }

    .dialog-head h2 {
      font-size: clamp(2rem, 10vw, 3rem);
    }

    dialog ul {
      flex: 1 1 auto;
      min-height: 0;
      padding: 0 12px;
      overflow-x: hidden;
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    dialog li {
      width: 100%;
      max-width: 100%;
    }

    .dialog-foot {
      display: none;
    }
  }
</style>
