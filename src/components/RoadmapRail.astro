---
import type { Article, RoadmapUpdate } from "../lib/types";
import { articleSlug } from "./article-path";

interface Props {
  updates?: RoadmapUpdate[];
  articles?: Article[];
  date: string;
}

const { updates = [], articles = [], date } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const rows = updates.filter((update) => update.title && update.summary && update.sources?.length);
const linkedArticle = (update: RoadmapUpdate) => update.articleId
  ? articles.find((article) => article.id === update.articleId)
  : undefined;
const destination = (update: RoadmapUpdate) => linkedArticle(update)
  ? `${base}edition/${encodeURIComponent(date)}/article/${articleSlug(update.articleId!)}/`
  : update.sources[0].url;
---

{rows.length > 0 && (
  <aside class="roadmap-rail" aria-labelledby="roadmap-heading">
    <header>
      <p class="eyebrow">Product direction</p>
      <h2 id="roadmap-heading">Roadmap updates</h2>
    </header>
    <ul>
      {rows.map((update) => (
        <li>
          <h3><a href={destination(update)}><span>{update.title}</span><span class="chevron" aria-hidden="true">›</span></a></h3>
          <p>{update.summary}</p>
          {update.sources.length === 1 ? (
            <span class="status">{update.sources[0].status && `Roadmap: ${update.sources[0].status}`}</span>
          ) : (
            <ul class="sources" aria-label={`Sources for ${update.title}`}>
              {update.sources.map((source) => <li><a href={source.url}>{source.title} <span aria-hidden="true">↗</span></a>{source.status && <span class="status"> · {source.status}</span>}</li>)}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </aside>
)}

<style>
  .roadmap-rail { border-top: 3px double var(--rule-dark); }
  header { padding: 0.85rem 0; border-bottom: 1px solid var(--rule-dark); }
  header .eyebrow { margin: 0 0 0.25rem; }
  h2 { margin: 0; font: 400 1.6rem/1.1 var(--display); }
  ul { margin: 0; padding: 0; list-style: none; }
  li { padding: 0.85rem 0; border-bottom: 1px solid var(--rule); }
  h3 { margin: 0; font: 700 0.94rem/1.3 var(--sans); }
  h3 a { display: flex; justify-content: space-between; gap: 0.6rem; color: var(--ink); text-decoration: none; }
  h3 a:hover span:first-child { text-decoration: underline; text-underline-offset: 0.15em; }
  h3 a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .chevron { flex-shrink: 0; color: var(--muted); font: 600 1.3rem/1 var(--sans); }
  p { margin: 0.35rem 0; font: 400 0.83rem/1.5 var(--sans); }
  .status { color: var(--muted); font: 500 0.66rem/1.4 var(--sans); }
  .sources { margin-top: 0.45rem; }
  .sources li { padding: 0.2rem 0; border: 0; font: 500 0.7rem/1.4 var(--sans); }
</style>
