---
import "../styles/global.css";
import type { ArticleMedia } from "../lib/types";

interface Props {
  title?: string;
  description?: string;
  image?: Pick<ArticleMedia, "url" | "alt" | "width" | "height">;
  article?: { headline: string; datePublished: string };
}

const {
  title = "OHF Daily",
  description = "A daily briefing on the open-source work moving the Open Home forward.",
  article,
  image = {
    url: "ohf-daily-og.png",
    alt: "OHF Daily logo on a cream background",
    width: 1200,
    height: 630,
  },
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const imageUrl = image && new URL(
  /^https?:\/\//i.test(image.url) ? image.url : `${base}${image.url.replace(/^\/+/, "")}`,
  Astro.site ?? Astro.url,
).href;
const publicationUrl = new URL(base, Astro.site ?? Astro.url).href;
const newsroom = {
  "@type": "Organization",
  "@id": `${publicationUrl}#newsroom`,
  name: "OHF Daily",
  url: publicationUrl,
  description: "Automated reporting on the Open Home Foundation ecosystem.",
};
const articleData = article && {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "@id": `${canonical.href}#article`,
  url: canonical.href,
  mainEntityOfPage: canonical.href,
  headline: article.headline,
  description,
  datePublished: article.datePublished,
  inLanguage: "en",
  author: newsroom,
  publisher: newsroom,
  ...(imageUrl ? { image: [imageUrl] } : {}),
};
// Keep source-derived text from terminating the JSON-LD script element.
const articleJson = articleData && JSON.stringify(articleData).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f6f3eb" />
    <meta name="description" content={description} />
    <meta property="og:site_name" content="OHF Daily" />
    <meta property="og:type" content={article ? "article" : "website"} />
    {article && <>
      <meta name="author" content="OHF Daily" />
      <meta property="article:published_time" content={article.datePublished} />
    </>}
    {articleJson && <script type="application/ld+json" set:html={articleJson} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && imageUrl && <>
      <meta property="og:image" content={imageUrl} />
      <meta property="og:image:alt" content={image.alt} />
      {image.width && <meta property="og:image:width" content={String(image.width)} />}
      {image.height && <meta property="og:image:height" content={String(image.height)} />}
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:image" content={imageUrl} />
      <meta name="twitter:image:alt" content={image.alt} />
    </>}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="OHF Daily" href={`${base}rss.xml`} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
