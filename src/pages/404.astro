---
import BaseLayout from "../layouts/BaseLayout.astro";
import Masthead from "../components/Masthead.astro";
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<BaseLayout title="Page not found · OHF Daily">
  <Masthead section="Late-breaking correction" />
  <main class="shell">
    <p class="eyebrow">Error 404</p>
    <h1>This story missed the edition.</h1>
    <p>The page may have moved, or the address may be incomplete.</p>
    <a href={base}>Back to today’s front page</a>
  </main>
</BaseLayout>

<style>
  main {
    display: grid;
    min-height: 55vh;
    align-content: center;
    justify-items: center;
    padding-block: 4rem;
    text-align: center;
  }

  h1 {
    max-width: 800px;
    margin: 0;
    font: 400 clamp(3rem, 8vw, 7rem)/0.92 var(--display);
  }

  main > p:not(.eyebrow) {
    color: var(--muted);
    font-size: 1.1rem;
  }

  main > a {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--ink);
    font: 700 0.68rem/1 var(--label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
