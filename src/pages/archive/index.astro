---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Masthead from "../../components/Masthead.astro";
import { editions, formatEditionDate } from "../../lib/editions";

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const href = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
const monthName = (yearMonth: string) => new Intl.DateTimeFormat("en", { month: "long", year: "numeric", timeZone: "UTC" }).format(new Date(`${yearMonth}-15T12:00:00Z`));
const editionTitle = (edition: (typeof editions)[number]) => {
  const articles = edition.articles ?? [];
  return articles.find((article) => article.placement === "lead")?.title ?? articles[0]?.title ?? edition.lead?.title ?? "A quiet news day";
};
const grouped = editions.reduce<Record<string, typeof editions>>((months, edition) => {
  const key = edition.date.slice(0, 7);
  (months[key] ??= []).push(edition);
  return months;
}, {});
const byYear = Object.entries(grouped).reduce<Record<string, Array<[string, typeof editions]>>>((years, entry) => {
  const year = entry[0].slice(0, 4);
  (years[year] ??= []).push(entry);
  return years;
}, {});
---

<BaseLayout title="Edition archive · OHF Daily" description="Browse past editions of OHF Daily by year and month.">
  <Masthead section="The edition archive" />
  <main class="shell">
    <header class="archive-head">
      <p class="eyebrow">Every edition, on the record</p>
      <h1>Archive</h1>
      <p>{editions.length ? `${editions.length} daily ${editions.length === 1 ? "edition" : "editions"}, organized by month.` : "Published editions will be filed here after each daily run."}</p>
    </header>

    {editions.length ? (
      <div class="years">
        {Object.entries(byYear).map(([year, months]) => (
          <section class="year" aria-labelledby={`year-${year}`}>
            <h2 id={`year-${year}`}>{year}</h2>
            <div class="months">
              {months.map(([month, monthEditions]) => (
                <section class="month">
                  <h3>{monthName(month)}</h3>
                  <ol>
                    {monthEditions.map((edition) => (
                      <li>
                        <a href={href(`/edition/${edition.date}/`)}>
                          <time datetime={edition.date}>{formatEditionDate(edition.date)}</time>
                          <span>{editionTitle(edition)}</span>
                          <small>{edition.stats.mergedPullRequests} PRs · {edition.stats.repositories} repositories</small>
                        </a>
                      </li>
                    ))}
                  </ol>
                </section>
              ))}
            </div>
          </section>
        ))}
      </div>
    ) : (
      <div class="empty-archive">
        <span aria-hidden="true">01</span>
        <p>The presses are ready. The first dated edition will appear here automatically.</p>
        <a href={href("/")}>Return to today’s front page</a>
      </div>
    )}
  </main>
</BaseLayout>

<style>
  main {
    padding-bottom: 5rem;
  }

  .archive-head {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 0 3rem;
    align-items: end;
    padding: clamp(2rem, 6vw, 5rem) 0 2rem;
    border-bottom: 3px double var(--rule-dark);
  }

  .archive-head .eyebrow {
    grid-column: 1 / -1;
  }

  .archive-head h1 {
    margin: 0;
    font: 400 clamp(4.5rem, 11vw, 10rem)/0.8 var(--display);
    letter-spacing: -0.065em;
  }

  .archive-head > p:last-child {
    max-width: 38rem;
    margin: 0;
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1.5;
  }

  .year {
    display: grid;
    grid-template-columns: minmax(100px, 0.25fr) minmax(0, 1.75fr);
    gap: 2rem;
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--rule-dark);
  }

  .year > h2 {
    position: sticky;
    top: 1rem;
    align-self: start;
    margin: 0;
    font: 400 clamp(2.4rem, 5vw, 4.8rem)/1 var(--display);
  }

  .months {
    display: grid;
    gap: 2.5rem;
  }

  .month h3 {
    margin: 0;
    padding-bottom: 0.65rem;
    border-bottom: 3px double var(--rule-dark);
    font: 400 1.7rem/1 var(--display);
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li a {
    display: grid;
    grid-template-columns: minmax(190px, 0.8fr) minmax(240px, 1.5fr) minmax(160px, 0.7fr);
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }

  li a:hover span {
    text-decoration: underline;
  }

  time,
  small {
    font: 600 0.7rem/1.4 var(--sans);
  }

  li span {
    font-size: 1.03rem;
    line-height: 1.3;
  }

  small {
    color: var(--muted);
  }

  .empty-archive {
    display: grid;
    place-items: center;
    min-height: 45vh;
    padding: 3rem 0;
    text-align: center;
  }

  .empty-archive span {
    display: grid;
    width: 7rem;
    height: 7rem;
    place-items: center;
    border: 1px solid var(--rule-dark);
    border-radius: 50%;
    font: 400 2.5rem/1 var(--display);
  }

  .empty-archive p {
    max-width: 30rem;
    margin: 1.5rem 0 0.8rem;
    font: 400 1.5rem/1.2 var(--display);
  }

  .empty-archive a {
    font: 700 0.68rem/1.2 var(--label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 720px) {
    .archive-head,
    .year {
      grid-template-columns: 1fr;
    }

    .archive-head {
      gap: 1.3rem;
    }

    .year > h2 {
      position: static;
    }

    li a {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
