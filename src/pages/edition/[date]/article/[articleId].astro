---
import type { GetStaticPaths } from "astro";
import type { Article, Edition } from "../../../../lib/types";
import { editions, formatEditionDate } from "../../../../lib/editions";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Masthead from "../../../../components/Masthead.astro";
import StoryCard from "../../../../components/StoryCard.astro";
import { articleSlug } from "../../../../components/article-path";

export const getStaticPaths = (() => editions.flatMap((edition, index) =>
  (edition.articles ?? []).map((article) => ({
    params: { date: edition.date, articleId: articleSlug(article.id) },
    props: { edition, article, previousDate: editions[index + 1]?.date },
  })),
)) satisfies GetStaticPaths;

interface Props {
  edition: Edition;
  article: Article;
  previousDate?: string;
}

const { edition, article, previousDate } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const href = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
const editionHref = href(`/edition/${encodeURIComponent(edition.date)}/`);
const topic = article.kind === "weekly_recap" ? "Week in review" : article.topics?.[0] || "Reported story";
---

<BaseLayout title={`${article.title} · OHF Daily`} description={article.dek || `OHF Daily article for ${formatEditionDate(edition.date)}.`}>
  <Masthead date={edition.date} {previousDate} section={`${topic} · ${formatEditionDate(edition.date)}`} />
  <main class="article-page shell">
    <nav class="breadcrumbs" aria-label="Article navigation">
      <a href={editionHref}><span aria-hidden="true">←</span> Back to the edition</a>
      <a href={href("/archive/")}>Edition archive</a>
    </nav>
    <StoryCard article={article} variant="detail" />
    <nav class="after-article" aria-label="After this article">
      <div>
        <p>Continue reading</p>
        <a href={editionHref}>Return to the {formatEditionDate(edition.date)} edition</a>
      </div>
      <a href={href("/archive/")}>Browse every edition <span aria-hidden="true">→</span></a>
    </nav>
  </main>
</BaseLayout>

<style>
  .article-page {
    padding-bottom: 4rem;
  }

  .breadcrumbs {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(2rem, 5vw, 4.5rem);
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--rule);
    font: 700 0.65rem/1.3 var(--label);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .after-article {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: end;
    margin-top: clamp(2.5rem, 6vw, 5rem);
    padding-block: 1.2rem;
    border-block: 3px double var(--rule-dark);
  }

  .after-article p {
    margin: 0 0 0.35rem;
    color: var(--muted);
    font: 700 0.62rem/1.3 var(--label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .after-article a {
    font: 400 clamp(1.2rem, 2vw, 1.75rem)/1.1 var(--display);
  }

  .after-article > a {
    font: 700 0.68rem/1.3 var(--label);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  @media (max-width: 620px) {
    .breadcrumbs {
      align-items: center;
    }

    .breadcrumbs a:last-child {
      font-size: 0;
    }

    .breadcrumbs a:last-child::after {
      content: "Archive";
      font-size: 0.65rem;
    }

    .after-article {
      display: grid;
      align-items: start;
    }
  }
</style>
